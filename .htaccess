# Martlsoft – Einstellungen für den IONOS-Webspace (Apache)
# Auf GitHub Pages wird diese Datei ignoriert.

# Immer verschlüsselt (https) und ohne "www."
RewriteEngine On
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# Downloads laufen über download.php (zählt mit, ohne personenbezogene Daten).
# Direkte Links auf downloads/<app>/<datei> bleiben gültig und werden hierher umgeleitet,
# die Programmdateien selbst sind so nicht direkt abrufbar.
RewriteRule ^downloads/([a-z0-9-]+)/([^/]+)$ download.php?app=$1&datei=$2 [L,QSA]

# Eigene Fehlerseite bei falschen Links
ErrorDocument 404 /404.html

# Ordnerinhalte nicht auflisten
Options -Indexes

# Interne Dateien nicht ausliefern
<FilesMatch "^(\.git|\.nojekyll|ANLEITUNG.*|.*\.md|.*\.ps1)$">
  Require all denied
</FilesMatch>
RedirectMatch 404 /\.git
# Zählerstand, Passwort-Hash und PHP-Bausteine nie ausliefern
RedirectMatch 404 ^/(daten|inc)(/|$)

# Sicherheits-Header
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Richtige Zeichenkodierung (Umlaute)
AddDefaultCharset utf-8
AddType image/svg+xml .svg

# Downloads (Windows-Programme) immer als Datei speichern
AddType application/zip .zip
AddType application/octet-stream .exe
<IfModule mod_headers.c>
  <FilesMatch "\.(exe|zip)$">
    Header set Content-Disposition attachment
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Update-Prüfung der Windows-Programme: version.json darf von der App (localhost) gelesen werden
<IfModule mod_headers.c>
  <Files "version.json">
    Header set Access-Control-Allow-Origin "*"
    Header set Cache-Control "no-cache"
  </Files>
</IfModule>

# Schneller laden: Bilder lange zwischenspeichern, Seiten kurz
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType text/css "access plus 1 day"
  ExpiresByType application/javascript "access plus 1 day"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>
